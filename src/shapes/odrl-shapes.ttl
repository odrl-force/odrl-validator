# An RDF list whose members are IRIs or strings
:IriOrStringListShape a sh:NodeShape ;
    sh:node :RdfListShape ;
    sh:property [
        sh:path ( [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:or ( [ sh:nodeKind sh:IRI ] [ sh:node :StringShape ] ) ;
    ] .

# An RDF list whose members are IRIs
:IriListShape a sh:NodeShape ;
    sh:node :RdfListShape ;
    sh:property [
        sh:path ( [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:nodeKind sh:IRI ;
    ] .

# An RDF list whose members are strings
:StringListShape a sh:NodeShape ;
    sh:node :RdfListShape ;
    sh:property [
        sh:path ( [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:node :StringShape ;
    ] .

# Subtypes: https://www.w3.org/TR/xmlschema11-2/#built-in-datatypes

# xsd:decimal and subtypes
:DecimalShape a sh:NodeShape ;
    sh:or (
        [ sh:datatype xsd:decimal ]
        [ sh:node :IntegerShape ]
    ) .

# xsd:integer and subtypes
:IntegerShape a sh:NodeShape ;
    sh:or (
        [ sh:datatype xsd:integer ]
        [ sh:datatype xsd:long ]
        [ sh:datatype xsd:int ]
        [ sh:datatype xsd:short ]
        [ sh:datatype xsd:byte ]
        [ sh:datatype xsd:nonNegativeInteger ]
        [ sh:datatype xsd:positiveInteger ]
        [ sh:datatype xsd:unsignedLong ]
        [ sh:datatype xsd:unsignedInt ]
        [ sh:datatype xsd:unsignedShort ]
        [ sh:datatype xsd:unsignedByte ]
        [ sh:datatype xsd:nonPositiveInteger ]
        [ sh:datatype xsd:negativeInteger ]
    ) .

#  xsd:date, xsd:dateTime and subtypes
:DateTimeShape a sh:NodeShape ;
    sh:or (
        [ sh:datatype xsd:date ]
        [ sh:datatype xsd:dateTime ]
        [ sh:datatype xsd:dateTimeStamp ]
    ) .

# xsd:duration and subtypes
:DurationShape a sh:NodeShape ;
    sh:or (
        [ sh:datatype xsd:duration ]
        [ sh:datatype xsd:dayTimeDuration ]
        [ sh:datatype xsd:yearMonthDuration ]
    ) .

# xsd:string and subtypes
:StringShape a sh:NodeShape ;
    sh:or (
        [ sh:datatype xsd:string ]
        [ sh:datatype xsd:normalizedString ]
        [ sh:datatype xsd:token ]
        [ sh:datatype xsd:language ]
        [ sh:datatype xsd:Name ]
        [ sh:datatype xsd:NCName ]
        [ sh:datatype xsd:ENTITY ]
        [ sh:datatype xsd:ID ]
        [ sh:datatype xsd:IDREF ]
        [ sh:datatype xsd:NMTOKEN ]
    ) .
