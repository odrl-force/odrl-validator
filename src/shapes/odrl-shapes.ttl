
@prefix : <http://example.com/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .


#################################################
# Shape for Policy
#################################################

:PolicyShape a sh:NodeShape ;
    sh:targetClass odrl:Policy ;
    # Only policies have rules: this also finds policies whose class is unknown (e.g. from a profile that is not loaded).
    sh:targetSubjectsOf odrl:permission, odrl:prohibition, odrl:obligation ;
    # R03: a policy must be identified by an IRI
    sh:nodeKind sh:IRI ;
    sh:message "Policies must be identified by an IRI." ;

    sh:closed true;

    # R107: a policy must be typed as an ODRL policy class, or as a subclass of odrl:Policy from a loaded profile
    sh:property [
        sh:path rdf:type ;
        sh:qualifiedValueShape [
            sh:in ( odrl:Policy odrl:Agreement odrl:Assertion odrl:Offer odrl:Privacy odrl:Request odrl:Set odrl:Ticket ) ;
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "The policy type must be an ODRL policy class, or a subclass of odrl:Policy defined in a loaded profile." ;
    ] ;

    # R04: a policy uid must be an IRI and appear at most once
    sh:property [
        sh:path odrl:uid ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "A Policy may have one uid, and it must be an IRI." ;
    ] ;

    # R02: a policy must include at least one rule (permission, prohibition or obligation)
    sh:property [
        sh:path [ sh:alternativePath ( odrl:permission odrl:prohibition odrl:obligation ) ] ;
        sh:minCount 1 ;
        sh:message "Policies must have at least one permission, obligation or prohibition." ;
    ] ;

    # R108: a permission of a policy must not be typed as a Prohibition or Duty
    sh:property [
        sh:path odrl:permission ;
        sh:node :PermissionShape ;
    ] ;
    sh:property [
        sh:path odrl:permission ;
        sh:not [ sh:or ( [ sh:class odrl:Prohibition ] [ sh:class odrl:Duty ] ) ] ;
        sh:message "A permission must be an odrl:Permission, not a Prohibition or Duty." ;
    ] ;


    # R109: an obligation of a policy must not be typed as a Permission or Prohibition
    sh:property [
        sh:path odrl:obligation ;
        sh:node :DutyShape ;
    ] ;
    sh:property [
        sh:path odrl:obligation ;
        sh:not [ sh:or ( [ sh:class odrl:Permission ] [ sh:class odrl:Prohibition ] ) ] ;
        sh:message "An obligation must be an odrl:Duty, not a Permission or Prohibition." ;
    ] ;

    # R110: a prohibition of a policy must not be typed as a Permission or Duty
    sh:property [
        sh:path odrl:prohibition ;
        sh:node :ProhibitionShape ;
    ] ;
    sh:property [
        sh:path odrl:prohibition ;
        sh:not [ sh:or ( [ sh:class odrl:Permission ] [ sh:class odrl:Duty ] ) ] ;
        sh:message "A prohibition must be an odrl:Prohibition, not a Permission or Duty." ;
    ] ;

    # R05: a policy profile must be an IRI
    sh:property [
        sh:path odrl:profile ;
        sh:nodeKind sh:IRI ;
        sh:message "Profile must be an IRI." ;
    ] ;

    # R06: a policy inheritFrom must reference an existing odrl:Policy
    sh:property [
        sh:path odrl:inheritFrom ;
        sh:nodeKind sh:IRI ;
        sh:class odrl:Policy ;
        sh:message "inheritFrom must reference an existing odrl:Policy." ;
    ] ;

    # R07: a policy conflict strategy must appear at most once and be an IRI
    sh:property [
        sh:path odrl:conflict ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
        sh:message "Conflict strategy must appear at most once and be a ConflictTerm: odrl:perm, odrl:prohibit, or odrl:invalid." ;
    ] .

# R08: a policy conflict strategy must be a known ODRL value or a profile must be declared

:ConflictStrategyShape a sh:NodeShape ;
    sh:targetClass odrl:Policy, odrl:Set, odrl:Offer, odrl:Agreement ;
    sh:property [
        sh:severity sh:Violation ;
        sh:path odrl:conflict ;
        sh:in ( odrl:perm odrl:prohibit odrl:invalid ) ;
        sh:message "The conflict strategy must be odrl:perm, odrl:prohibit or odrl:invalid, or a conflict term defined in a loaded profile." ;
    ] .

# Set = Policy

:SetPolicyShape a sh:NodeShape ;
    sh:targetClass odrl:Set ;
    sh:node :PolicyShape .


# Offer = Rules must have one assigner
# R09: every rule in an Offer must have exactly one assigner

:OfferPolicyShape a sh:NodeShape ;
    sh:targetClass odrl:Offer ;
    sh:node :PolicyShape ;

    sh:property [
        sh:path odrl:permission ;
        sh:node :OfferPermissionShape ;
    ] ;

    sh:property [
        sh:path odrl:prohibition ;
        sh:node :OfferProhibitionShape ;
    ] ;

    sh:property [
        sh:path odrl:obligation ;
        sh:node :OfferDutyShape ;
    ] .


# Agreement = Rules must have one assigner and one assignee
# R10: every rule in an Agreement must have exactly one assigner and one assignee

:AgreementPolicyShape a sh:NodeShape ;
    sh:targetClass odrl:Agreement ;
    sh:node :PolicyShape ;

    sh:property [
        sh:path odrl:permission ;
        sh:node :AgreementPermissionShape ;
    ] ;

    sh:property [
        sh:path odrl:prohibition ;
        sh:node :AgreementProhibitionShape ;
    ] ;

    sh:property [
        sh:path odrl:obligation ;
        sh:node :AgreementDutyShape ;
    ] .

# R06: shacl-engine only knows the subclasses declared in the shapes graph

odrl:Agreement rdfs:subClassOf odrl:Policy .
odrl:Assertion rdfs:subClassOf odrl:Policy .
odrl:Offer rdfs:subClassOf odrl:Policy .
odrl:Privacy rdfs:subClassOf odrl:Policy .
odrl:Request rdfs:subClassOf odrl:Policy .
odrl:Set rdfs:subClassOf odrl:Policy .
odrl:Ticket rdfs:subClassOf odrl:Policy .


#################################################
# Shape for Rule = must have one action
#################################################

:RuleShape a sh:NodeShape ;
    sh:targetClass odrl:Permission, odrl:Prohibition, odrl:Duty ;

    sh:closed true;
    sh:ignoredProperties ( odrl:duty odrl:remedy odrl:consequence <http://example.org/ns/derivedFrom> ) ;

    # R???: a rule must be typed as an ODRL Permission, ODRL Prohibition or ODRL Duty.
    sh:or (
        [ sh:class odrl:Permission ]
        [ sh:class odrl:Prohibition ]
        [ sh:class odrl:Duty ]
    ) ;
    sh:message "A rule must be typed as odrl:Permission, odrl:Prohibition or odrl:Duty." ;

    # Declares rdf:type so the closed shape allows it (the type itself is checked by the sh:or above).
    sh:property [
        sh:path rdf:type ;
    ] ;

    # R112: a rule may have at most one uid, and it must be an IRI
    sh:property [
        sh:path odrl:uid ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "A Rule may have one uid, and it must be an IRI." ;
    ] ;

    # R11: every rule must have exactly one action
    sh:property [
        sh:path odrl:action ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A Rule must have one action." ;
    ] ;
    # R12: an action must be a known value, or a blank node with rdf:value and refinement
    sh:property [
        sh:path odrl:action ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:or (
            [ sh:node :ActionShape ]
            [ sh:node :ActionWithRefinementShape ]
        );
        sh:message "Action should be a supported action or a blank node with rdf:value and odrl:refinement." ;    
    ] ;
    # R13: an action should belong to the ODRL vocabulary or be typed as odrl:Action
    sh:property [
        sh:severity sh:Violation ;
        sh:path odrl:action ;
        sh:or (
            [ sh:node :AllowedActionValueShape ]
            [ sh:node :ActionWithRefinementShape ]
        ) ;
        sh:message "Action is neither part of the ODRL Vocabulary nor typed as odrl:Action in a profile." ;
    ] ;
    sh:property [
        sh:severity sh:Violation ;
        sh:path (odrl:action rdf:value) ;
        sh:node :AllowedActionValueShape ;
    ] ;

    # R14: a rule may have at most one target
    sh:property [
        sh:path odrl:target ;
        sh:maxCount 1 ;
        sh:message "A Rule may have one target." ;
    ] ;
    # R15: a target must be an Asset or an AssetCollection
    sh:property [
        sh:path odrl:target ;
        sh:or (
            [ sh:node :AssetShape ]
            [ sh:node :AssetCollectionShape ]
        );
        sh:message "Target should be a supported asset or a blank node with rdf:value." ;    
    ] ;
    # R16: a target should be typed as odrl:Asset or odrl:AssetCollection
    sh:property [
        sh:severity sh:Warning ;
        sh:path odrl:target ;
        sh:or (
            [ sh:class odrl:Asset ]
            [ sh:class odrl:AssetCollection ]
        ) ;
        sh:message "Target should be a Asset or AssetCollection." ;
    ] ;

    # R17: a rule may have at most one assignee
    sh:property [
    sh:path odrl:assignee ;
    sh:maxCount 1 ;
    sh:message "A Rule may have at most one assignee." ;
    ] ;
    # R18: an assignee must conform to the Party or PartyCollection shape
    sh:property [
        sh:path odrl:assignee ;
        sh:or (
            [ sh:node :PartyShape ]
            [ sh:node :PartyCollectionShape ]
        );
        sh:message "Assignee should be a supported party or a blank node with rdf:value." ;
    ] ;
    # R19: an assignee should be typed as odrl:Party or odrl:PartyCollection
    sh:property [
        sh:severity sh:Warning ;
        sh:path odrl:assignee ;
        sh:or (
            [ sh:class odrl:Party ]
            [ sh:class odrl:PartyCollection ]
        ) ;
        sh:message "The assignee should be a Party or PartyCollection." ;
    ] ;

    # R20: a rule may have at most one assigner
    sh:property [
        sh:path odrl:assigner ;
        sh:maxCount 1 ;
        sh:message "A Rule may have at most one assigner." ;
    ] ;
    # R21: an assigner must conform to the Party or PartyCollection shape
    sh:property [
        sh:path odrl:assigner ;
        sh:or (
            [ sh:node :PartyShape ]
            [ sh:node :PartyCollectionShape ]
        );        
        sh:message "Assigner should be a supported party or a blank node with rdf:value." ;    
    ] ;
    # R22: an assigner should be typed as odrl:Party or odrl:PartyCollection
    sh:property [
        sh:severity sh:Warning ;
        sh:path odrl:assigner ;
        sh:or (
            [ sh:class odrl:Party ]
            [ sh:class odrl:PartyCollection ]
        ) ;
        sh:message "The assigner should be a Party or PartyCollection." ;
    ] ;

    # R23: each constraint in a rule must be a valid Constraint or LogicalConstraint
    sh:property [
        sh:path odrl:constraint ;
        sh:or (
            [ sh:node :ConstraintShape ]
            [ sh:node :LogicalConstraintShape ]
        ) ;
        sh:message "Each constraint must conform to ODRL constraint or ODRL logical constraint." ;
    ] ;
    # R24: constraint terms should belong to the ODRL vocabulary or be correctly typed
    # message error comes from R41 and R42
    sh:property [
        sh:severity sh:Violation ;
        sh:path odrl:constraint ;
        sh:node :AllowedConstraintValueShape ;
    ] .

# Needs profile

# R31: a collection with odrl:refinement must have an odrl:source or rdf:value
:RefinementNeedsSourceShape a sh:NodeShape ;
    sh:targetSubjectsOf odrl:refinement ;
    sh:or (
        [ sh:property [ sh:path odrl:source ; sh:minCount 1 ] ]
        [ sh:property [ sh:path rdf:value ; sh:minCount 1 ] ]
    ) ;
    sh:message "A collection with refinement must have one source." .

# R32: an action outside the ODRL vocabulary requires a declared odrl:profile
:ActionRequiresProfileShape a sh:NodeShape ;
    sh:targetClass odrl:Policy, odrl:Set, odrl:Offer, odrl:Agreement ;
    sh:or (
        [ sh:property [ sh:path odrl:profile ; sh:minCount 1 ] ]
        [
            sh:property [
                sh:path ( [ sh:alternativePath ( odrl:permission odrl:prohibition odrl:obligation ) ] odrl:action ) ;
                sh:or (
                    [ sh:node :AllowedActionValueShape ]
                    [ sh:nodeKind sh:Literal ]
                    [ sh:node :ActionWithRefinementShape ]
                ) ;
            ] ;
            sh:property [
                sh:path ( [ sh:alternativePath ( odrl:permission odrl:prohibition odrl:obligation ) ] odrl:action rdf:value ) ;
                sh:node :AllowedActionValueShape ;
            ] ;
        ]
    ) ;
    sh:message "An action outside the ODRL vocabulary requires a declared odrl:profile." .

# R33: a constraint term outside the ODRL vocabulary requires a declared odrl:profile
:ConstraintVocabRequiresProfileShape a sh:NodeShape ;
    sh:targetClass odrl:Policy, odrl:Set, odrl:Offer, odrl:Agreement ;
    sh:or (
        [ sh:property [ sh:path odrl:profile ; sh:minCount 1 ] ]
        [ sh:property [
            sh:path ( [ sh:alternativePath ( odrl:permission odrl:prohibition odrl:obligation ) ] odrl:constraint ) ;
            sh:node :AllowedConstraintValueShape ;
        ] ]
    ) ;
    sh:message "A constraint term (leftOperand/operator) outside the ODRL vocabulary requires a declared odrl:profile." .


# Permission = must have one target

:PermissionShape a sh:NodeShape ;
    sh:targetClass odrl:Permission ;
    sh:node :RuleShape ;

    # R25: a permission must have exactly one target
    sh:property [
        sh:path odrl:target ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A Permission must have one odrl:target." ;
    ] ;

    # R26: each duty of a permission must conform to the Duty shape
    sh:property [
        sh:path odrl:duty ;  
        sh:node :DutyShape ;  
        sh:message "Each Permission duty must conform to ODRL duty." ;
    ] ;
    sh:property [
        sh:path odrl:duty ;
        sh:not [ sh:or ( [ sh:class odrl:Permission ] [ sh:class odrl:Prohibition ] ) ] ;
        sh:message "A duty must be an odrl:Duty, not a Permission or Prohibition." ;
    ] .

# Prohibition = must have one target

:ProhibitionShape a sh:NodeShape ;
    sh:targetClass odrl:Prohibition ;
    sh:node :RuleShape ;

    # R27: a prohibition must have exactly one target
    sh:property [
        sh:path odrl:target ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A Prohibition must have one odrl:target." ;
    ] ;

    # R28: each remedy of a prohibition must conform to the Duty shape
    sh:property [
        sh:path odrl:remedy ;
        sh:node [
            sh:node :DutyShape ;

            # R29: a remedy must not have a consequence
            sh:property [
                sh:path odrl:consequence ;
                sh:maxCount 0 ;
                sh:message "A remedy must not have a consequence." ;
            ]
        ] ;
        sh:message "Each Prohibition remedy must conform to ODRL duty." ;
    ] ;
    sh:property [
        sh:path odrl:remedy ;
        sh:not [ sh:or ( [ sh:class odrl:Permission ] [ sh:class odrl:Prohibition ] ) ] ;
        sh:message "A remedy must be an odrl:Duty, not a Permission or Prohibition." ;
    ] .



# Duty = Rule
:DutyShape a sh:NodeShape ;
    sh:targetClass odrl:Duty ;
    sh:node :RuleShape ;

    # R30: each consequence of a duty must conform to the Duty shape
    sh:property [
        sh:path odrl:consequence ;  
        sh:node :DutyShape ;  
        sh:message "Each Duty consequence must conform to ODRL duty." ;
    ] ;
    sh:property [
        sh:path odrl:consequence ;
        sh:not [ sh:or ( [ sh:class odrl:Permission ] [ sh:class odrl:Prohibition ] ) ] ;
        sh:message "A consequence must be an odrl:Duty, not a Permission or Prohibition." ;
    ] .

# R09: every rule in an Offer must have exactly one assigner

:OfferPermissionShape a sh:NodeShape ;
    sh:node :PermissionShape ;
    sh:node :OfferRequiredAssignerShape .

:OfferProhibitionShape a sh:NodeShape ;
    sh:node :ProhibitionShape ;
    sh:node :OfferRequiredAssignerShape .

:OfferDutyShape a sh:NodeShape ;
    sh:node :DutyShape ;
    sh:node :OfferRequiredAssignerShape .

:OfferRequiredAssignerShape a sh:NodeShape ;
    sh:property [
        sh:path odrl:assigner ;
        sh:minCount 1 ;
        sh:message "An Offer rule must have one assigner." ;
    ] .

# R10: every rule in an Agreement must have exactly one assigner and one assignee

:AgreementPermissionShape a sh:NodeShape ;
    sh:node :PermissionShape ;
    sh:node :AgreementRequiredAssignerShape ;
    sh:node :AgreementRequiredAssigneeShape .

:AgreementProhibitionShape a sh:NodeShape ;
    sh:node :ProhibitionShape ;
    sh:node :AgreementRequiredAssignerShape ;
    sh:node :AgreementRequiredAssigneeShape .

:AgreementDutyShape a sh:NodeShape ;
    sh:node :DutyShape ;
    sh:node :AgreementRequiredAssignerShape ;
    sh:node :AgreementRequiredAssigneeShape .

:AgreementRequiredAssignerShape a sh:NodeShape ;
    sh:property [
        sh:path odrl:assigner ;
        sh:minCount 1 ;
        sh:message "An Agreement rule must have one assigner." ;
    ] .

:AgreementRequiredAssigneeShape a sh:NodeShape ;
    sh:property [
        sh:path odrl:assignee ;
        sh:minCount 1 ;
        sh:message "An Agreement rule must have one assignee." ;
    ] .


#################################################
# Shape for Constraint = must have leftOperand, operator and rightOperand or rightOperandReference
#################################################

:ConstraintShape a sh:NodeShape ;
    sh:targetClass odrl:Constraint ;
    sh:closed true;

    sh:property [
        sh:path rdf:type ;
        sh:hasValue odrl:Constraint ;
        sh:message "A constraint must have the type of odrl:Constraint." ;
    ] ;

    # R115: a constraint may have at most one uid, and it must be an IRI
    sh:property [
        sh:path odrl:uid ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "A Constraint may have one uid, and it must be an IRI." ;
    ] ;

    # R116: a constraint may have at most one dataType, and it must be an IRI
    sh:property [
        sh:path odrl:dataType ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "A Constraint may have one dataType." ;
    ] ;

    # R117: a constraint may have at most one unit
    sh:property [
        sh:path odrl:unit ;
        sh:maxCount 1 ;
        sh:message "A Constraint may have at most one unit." ;
    ] ;

    # R119: a constraint may have at most one status
    sh:property [
        sh:path odrl:status ;
        sh:maxCount 1 ;
        sh:message "A Constraint may have one status." ;
    ] ;

    # R36: a constraint must have exactly one leftOperand
    sh:property [
        sh:path odrl:leftOperand ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A Constraint must have one odrl:leftOperand." ;
    ] ;

    # R37: a constraint must have exactly one operator
    sh:property [
        sh:path odrl:operator ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A Constraint must have one odrl:operator." ;
    ] ;
    
    # R38: a constraint must have either rightOperand or rightOperandReference, but not both and not neither
    sh:xone (
        [ 
            sh:property [ 
                sh:path odrl:rightOperand ; 
                sh:minCount 1 ;
                sh:message "A Constraint must have one of odrl:rightOperand or odrl:rightOperandReference (neither both nor none)." ;
        ] ]
        [ 
            sh:property [
                sh:path odrl:rightOperandReference ; 
                sh:minCount 1 ;
                sh:message "A Constraint must have one of odrl:rightOperand or odrl:rightOperandReference (neither both nor none)." ;
        ] ]
    ) ;

    # R39: the rightOperand must be a literal, IRI, odrl:RightOperand instance, or a list of these
    sh:property [
        sh:path odrl:rightOperand ;
        sh:maxCount 1 ;
        sh:or (
            [ sh:nodeKind sh:Literal ]
            [ sh:nodeKind sh:IRI ]
            [ sh:class odrl:RightOperand ]
            [ sh:node :RightOperandListShape ]
        ) ;
        sh:message "A Constraint must declare exactly one odrl:rightOperand, given as a literal, an IRI, an odrl:RightOperand instance, or a list of these." ;
    ] ;

    # R40: the rightOperandReference must be an IRI or a list of IRIs
    sh:property [
        sh:path odrl:rightOperandReference ;
        sh:maxCount 1 ;
        sh:or (
            [ sh:nodeKind sh:IRI ]
            [ sh:node :RightOperandReferenceListShape ]
        ) ;
        sh:message "A Constraint must declare exactly one odrl:rightOperandReference, given as an IRI or a list of IRIs." ;
    ] .

# R118: a constraint unit should be an IRI
# It is a separate shape: as a Warning inside :ConstraintShape, it would make the rule constraint (R23) a Violation.

:ConstraintUnitShape a sh:NodeShape ;
    sh:targetSubjectsOf odrl:unit ;
    sh:property [
        sh:severity sh:Warning ;
        sh:path odrl:unit ;
        sh:nodeKind sh:IRI ;
        sh:message "A Constraint unit should be an IRI." ;
    ] .

:RightOperandListShape a sh:NodeShape ;
    sh:node :RdfListShape ;
    sh:property [
        sh:path ( [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:or (
            [ sh:nodeKind sh:Literal ]
            [ sh:nodeKind sh:IRI ]
            [ sh:class odrl:RightOperand ]
        ) ;
        sh:message "Each value in rightOperand must be a literal, an IRI, or a RightOperand." ;
    ] .

:RightOperandReferenceListShape a sh:NodeShape ;
    sh:node :RdfListShape ;
    sh:property [
        sh:path ( [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:nodeKind sh:IRI ;
        sh:message "Each value in rightOperandReference must be an IRI." ;
    ] .

# Validate constraints without typed

:AnyConstraintShape a sh:NodeShape ;
    sh:targetSubjectsOf odrl:leftOperand ;
    sh:node :ConstraintShape .

#################################################
# Logical Constraint = must have one operand
#################################################

:LogicalConstraintShape a sh:NodeShape ;
    sh:targetClass odrl:LogicalConstraint ;
    sh:targetSubjectsOf odrl:or ;
    sh:targetSubjectsOf odrl:xone ;
    sh:targetSubjectsOf odrl:and ;
    sh:targetSubjectsOf odrl:andSequence ;

    sh:closed true;
    sh:property [
        sh:path rdf:type ;
        sh:hasValue odrl:LogicalConstraint ;
        sh:message "A logical constraint must have the type of odrl:LogicalConstraint." ;
    ] ;
    

    # R120: a LogicalConstraint may have at most one uid, and it must be an IRI
    sh:property [
        sh:path odrl:uid ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "A Logical Constraint may have one uid, and it must be an IRI." ;
    ] ;

    # R43: a LogicalConstraint must contain exactly one of: odrl:and, odrl:or, odrl:xone, odrl:andSequence
    sh:property [
        sh:path [ sh:alternativePath ( odrl:or odrl:xone odrl:and odrl:andSequence ) ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node :ConstraintListShape ;
        sh:message "A LogicalConstraint must contain one of odrl:and, odrl:or, odrl:xone, or odrl:andSequence." ;
    ] .

# R44: each element of a LogicalConstraint must be a valid Constraint
:ConstraintListShape a sh:NodeShape ;
    sh:node :RdfListShape ;
    sh:property [
        sh:path ( [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:node :ConstraintShape ;
        sh:message "Each value in a logical constraint must be a Constraint." ;
    ] .


#################################################
# Valid RDF list inspired by shsh:ListShape from SHACL-SHACL
#################################################

:RdfListShape a sh:NodeShape ;
    sh:property [
        sh:path [ sh:zeroOrMorePath rdf:rest ] ;
        sh:hasValue rdf:nil ;
        sh:node :RdfListNodeShape ;
    ] .

:RdfListNodeShape a sh:NodeShape ;
    sh:or (
        [
            sh:hasValue rdf:nil ;
            sh:property [
                sh:path rdf:first ;
                sh:maxCount 0 ;
            ] ;
            sh:property [
                sh:path rdf:rest ;
                sh:maxCount 0 ;
            ]
        ]
        [
            sh:not [ sh:hasValue rdf:nil ] ;
            sh:property [
                sh:path rdf:first ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
            ] ;
            sh:property [
                sh:path rdf:rest ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
            ]
        ]
    ) .
    
#################################################
# Shape for odrl vocabulary
#################################################

:AllowedConstraintValueShape a sh:NodeShape ;
    sh:targetClass odrl:Constraint ; 

    # R41: the leftOperand should belong to the ODRL vocabulary or be typed as odrl:LeftOperand
    sh:property [
        sh:severity sh:Violation ;
        sh:path odrl:leftOperand ;
        sh:or ([
            sh:in (
                odrl:absolutePosition
                odrl:absoluteSpatialPosition
                odrl:absoluteTemporalPosition
                odrl:absoluteSize
                odrl:count
                odrl:dateTime
                odrl:delayPeriod
                odrl:deliveryChannel
                odrl:elapsedTime
                odrl:event
                odrl:fileFormat
                odrl:industry
                odrl:language
                odrl:media
                odrl:meteredTime
                odrl:payAmount
                odrl:percentage
                odrl:product
                odrl:purpose
                odrl:recipient
                odrl:relativePosition
                odrl:relativeSpatialPosition
                odrl:relativeTemporalPosition
                odrl:relativeSize
                odrl:resolution
                odrl:spatial
                odrl:spatialCoordinates
                odrl:systemDevice
                odrl:timeInterval
                odrl:unitOfCount
                odrl:version
                odrl:virtualLocation
            ) ]
            [ 
                sh:class odrl:LeftOperand;
            ]) ;
        sh:message "The constraint leftOperand should be part of the ODRL vocabulary or typed as odrl:LeftOperand in a profile." ;
    ] ;
    
    # R42: the operator should be a standard ODRL operator
    sh:property [
        sh:severity sh:Violation ;
        sh:path odrl:operator ;
        sh:or ([
            sh:in (
                odrl:eq
                odrl:gt
                odrl:gteq
                odrl:lt
                odrl:lteq
                odrl:neq
                odrl:isA
                odrl:hasPart
                odrl:isPartOf
                odrl:isAllOf
                odrl:isAnyOf
                odrl:isNoneOf
            ) ]
            [ 
                sh:class odrl:Operator;
            ]) ;
        sh:message "The operator should be a standard ODRL operators or typed as odrl:Operator in a profile." ;
    ] .


#################################################
# Shape for Party
#################################################

:PartyShape a sh:NodeShape ;
    sh:targetClass odrl:Party ;

    # R99: a party may have at most one uid, and it must be an IRI
    sh:property [
        sh:path odrl:uid ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "A Party may have one uid, and it must be an IRI." ;
    ] ;

    # R100: a party partOf must point to a PartyCollection
    sh:property [
        sh:path odrl:partOf ;
        sh:node :PartyCollectionShape ;
        sh:message "partOf should point to an PartyCollection." ;
    ] ;
    # The collection may have no type, but it must not be an Asset.
    sh:property [
        sh:path odrl:partOf ;
        sh:not [ sh:or ( [ sh:class odrl:Asset ] [ sh:class odrl:AssetCollection ] ) ] ;
        sh:message "A Party must be partOf a PartyCollection, not an Asset or AssetCollection." ;
    ] .


:PartyCollectionShape a sh:NodeShape ;
    sh:targetClass odrl:PartyCollection ;

    # R101: a PartyCollection may have at most one source, and it must be an IRI
    sh:property [
        sh:path odrl:source ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "A PartyCollection may have one source, and it must be an IRI." ;
    ] ;
    
    # R102: each refinement of a PartyCollection must be a Constraint or LogicalConstraint
    sh:property [
        sh:path odrl:refinement ;
        sh:or (
            [ sh:node :ConstraintShape ]
            [ sh:node :LogicalConstraintShape ]
        ) ;
        sh:message "Each PartyCollection refinement must be a Constraint or LogicalConstraint." ;
    ] .


#################################################
# Shape for Action and Action with refinement
#################################################

:ActionShape a sh:NodeShape ;

    # R35: odrl:includedIn must be odrl:use or odrl:transfer and appear at most once
    sh:property [
        sh:path odrl:includedIn ;
        sh:maxCount 1 ;
        sh:in ( odrl:use odrl:transfer ) ;
        sh:message "The value of odrl:includedIn should be either odrl:use or odrl:transfer." ;
    ] ;

    # R113: each implies value must be an Action
    sh:property [
        sh:path odrl:implies ;
        sh:node :AllowedActionValueShape ;
        sh:message "Each implies value should be an Action." ;
    ] .

:ActionWithRefinementShape a sh:NodeShape ;

    # R34: an action refinement must have exactly one rdf:value
    sh:property [
        sh:path rdf:value ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "An action refinement must have one rdf:value." ;
    ] ;

    # R114: each refinement of an action must be a valid Constraint or LogicalConstraint
    sh:property [
        sh:path odrl:refinement ;
        sh:minCount 1 ;
        sh:or (
            [ sh:node :ConstraintShape ]
            [ sh:node :LogicalConstraintShape ]
        ) ;
        sh:message "An action with refinement must have a valid refinement." ;
    ] .

# R13: an action should belong to the ODRL vocabulary or be typed as odrl:Action
:AllowedActionValueShape a sh:NodeShape ;
    sh:severity sh:Violation ;
    sh:or ([
        sh:in (
            odrl:acceptTracking
            odrl:aggregate
            odrl:anonymize
            odrl:annotate
            odrl:archive
            odrl:attribute
            odrl:compensate
            odrl:concurrentUse
            odrl:delete
            odrl:derive
            odrl:digitize
            odrl:display
            odrl:distribute
            odrl:ensureExclusivity
            odrl:execute
            odrl:extract
            odrl:give
            odrl:grantUse
            odrl:include
            odrl:index
            odrl:inform
            odrl:install
            odrl:modify
            odrl:move
            odrl:nextPolicy
            odrl:obtainConsent
            odrl:play
            odrl:present
            odrl:print
            odrl:read
            odrl:reproduce
            odrl:reviewPolicy
            odrl:sell
            odrl:stream
            odrl:synchronize
            odrl:textToSpeech
            odrl:transfer
            odrl:transform
            odrl:translate
            odrl:uninstall
            odrl:use
            odrl:watermark
            cc:Attribution
            cc:CommercialUse
            cc:DerivativeWorks
            cc:Distribution
            cc:Notice
            cc:Reproduction
            cc:ShareAlike
            cc:Sharing
            cc:SourceCode
            # Deprecated ODRL terms
            odrl:append
            odrl:appendTo
            odrl:copy
            odrl:export
            odrl:lease
            odrl:license
            odrl:lend
            odrl:pay
            odrl:preview
            odrl:secondaryUse
            odrl:share
            odrl:write
            odrl:writeTo
            odrl:adHocShare
            odrl:extractChar
            odrl:extractPage
            odrl:extractWord
            odrl:timedCount
            ) 
    ][ 
        sh:class odrl:Action 
    ]) ;
    sh:message "Action is neither part of the ODRL Vocabulary nor typed as odrl:Action in a profile." .


#################################################
# Shape for Asset
#################################################

:AssetShape a sh:NodeShape ;
    sh:targetClass odrl:Asset ;

    # R103: an asset may have at most one uid, and it must be an IRI
    sh:property [
        sh:path odrl:uid ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "An Asset may have one uid, and it must be an IRI." ;
    ] ;

    # R104: an asset partOf must point to an AssetCollection
    sh:property [
        sh:path odrl:partOf ;
        sh:node :AssetCollectionShape ;
        sh:message "partOf should point to an AssetCollection." ;
    ] ;
    # The collection may have no type, but it must not be a Party.
    sh:property [
        sh:path odrl:partOf ;
        sh:not [ sh:or ( [ sh:class odrl:Party ] [ sh:class odrl:PartyCollection ] ) ] ;
        sh:message "An Asset must be partOf an AssetCollection, not a Party or PartyCollection." ;
    ] ;

    # R121: an asset hasPolicy must point to a Policy IRI
    sh:property [
        sh:path odrl:hasPolicy ;
        sh:nodeKind sh:IRI ;
        sh:message "hasPolicy must point to a Policy IRI." ;
    ] .

:AssetCollectionShape a sh:NodeShape ;
    sh:targetClass odrl:AssetCollection ;
    
    # R105: an AssetCollection may have at most one source, and it must be an IRI
    sh:property [
        sh:path odrl:source ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "An AssetCollection may have one source, and it must be an IRI." ;
    ] ;
    
    # R106: each refinement of an AssetCollection must be a Constraint or LogicalConstraint
    sh:property [
        sh:path odrl:refinement ;
        sh:or (
            [ sh:node :ConstraintShape ]
            [ sh:node :LogicalConstraintShape ]
        ) ;
        sh:message "Each AssetCollection refinement must be a Constraint or LogicalConstraint." ;
    ] .


#################################################
# Operator compatibility per leftOperand
#################################################

# R45: odrl:absolutePosition is only compatible with comparison operators

:AbsolutePositionOperatorShape a sh:NodeShape ;
    sh:targetClass odrl:Constraint ;
    sh:targetSubjectsOf odrl:leftOperand ; 
    sh:severity sh:Violation ;
    sh:or (
        [ sh:not [ sh:path odrl:leftOperand ; sh:hasValue odrl:absolutePosition ] ]
        [ sh:path odrl:operator ; sh:in ( odrl:eq odrl:gt odrl:gteq odrl:lt odrl:lteq odrl:neq ) ]
    ) ;
    sh:message "odrl:absolutePosition is only compatible with comparison operators odrl:eq, odrl:gt, odrl:gteq, odrl:lt, odrl:lteq or odrl:neq." .


