# R66: the rightOperand of odrl:language must be a string

:LanguageRightOperandShape a sh:NodeShape ;
    sh:targetClass odrl:Constraint ;
    sh:targetSubjectsOf odrl:leftOperand ;
    sh:severity sh:Warning ;
    sh:or (
        [ sh:not [ sh:path odrl:leftOperand ; sh:hasValue odrl:language ] ]
        [ sh:path odrl:rightOperand ; sh:or ( [ sh:datatype xsd:string ] [ sh:node :StringListShape ] ) ]
    ) ;
    sh:message "The rightOperand of odrl:language should be a string or a list of strings." .


# R68: the rightOperand of odrl:media must be a string

:MediaRightOperandShape a sh:NodeShape ;
    sh:targetClass odrl:Constraint ;
    sh:targetSubjectsOf odrl:leftOperand ;
    sh:severity sh:Warning ;
    sh:or (
        [ sh:not [ sh:path odrl:leftOperand ; sh:hasValue odrl:media ] ]
        [ sh:path odrl:rightOperand ; sh:or ( [ sh:datatype xsd:string ] [ sh:node :StringListShape ] ) ]
    ) ;
    sh:message "The rightOperand of odrl:media should be a string or a list of strings." .


# R70: the rightOperand of odrl:meteredTime must be an xsd:duration

:MeteredTimeRightOperandShape a sh:NodeShape ;
    sh:targetClass odrl:Constraint ;
    sh:targetSubjectsOf odrl:leftOperand ;
    sh:severity sh:Violation ;
    sh:or (
        [ sh:not [ sh:path odrl:leftOperand ; sh:hasValue odrl:meteredTime ] ]
        [ sh:path odrl:rightOperand ; sh:datatype xsd:duration ]
    ) ;
    sh:message "The rightOperand of odrl:meteredTime must be an xsd:duration." .


# R72: the rightOperand of odrl:payAmount must be an xsd:decimal

:PayAmountRightOperandShape a sh:NodeShape ;
    sh:targetClass odrl:Constraint ;
    sh:targetSubjectsOf odrl:leftOperand ;
    sh:severity sh:Violation ;
    sh:or (
        [ sh:not [ sh:path odrl:leftOperand ; sh:hasValue odrl:payAmount ] ]
        [ sh:path odrl:rightOperand ; sh:datatype xsd:decimal ]
    ) ;
    sh:message "The rightOperand of odrl:payAmount must be an xsd:decimal." .


# R74: the rightOperand of odrl:percentage must be an xsd:decimal between 0 and 100

:PercentageRightOperandShape a sh:NodeShape ;
    sh:targetClass odrl:Constraint ;
    sh:targetSubjectsOf odrl:leftOperand ;
    sh:severity sh:Violation ;
    sh:or (
        [ sh:not [ sh:path odrl:leftOperand ; sh:hasValue odrl:percentage ] ]
        [ sh:path odrl:rightOperand ; sh:datatype xsd:decimal ; sh:minInclusive 0 ; sh:maxInclusive 100 ]
    ) ;
    sh:message "The rightOperand of odrl:percentage must be an xsd:decimal from 0 to 100." .


# R76: the rightOperand of odrl:product must be an IRI or a string

:ProductRightOperandShape a sh:NodeShape ;
    sh:targetClass odrl:Constraint ;
    sh:targetSubjectsOf odrl:leftOperand ;
    sh:severity sh:Warning ;
    sh:or (
        [ sh:not [ sh:path odrl:leftOperand ; sh:hasValue odrl:product ] ]
        [ sh:path odrl:rightOperand ; sh:or ( [ sh:nodeKind sh:IRI ] [ sh:datatype xsd:string ] [ sh:node :IriOrStringListShape ] ) ]
    ) ;
    sh:message "The rightOperand of odrl:product should be an IRI, a string, or a list of these." .


