#################################################
# RightOperand datatype per leftOperand
#################################################

# R50: the rightOperand of odrl:count must be an xsd:integer

:CountRightOperandShape a sh:NodeShape ;
    sh:targetClass odrl:Constraint ;
    sh:targetSubjectsOf odrl:leftOperand ; 
    sh:severity sh:Warning ;
    sh:or (
        [ sh:not [ sh:path odrl:leftOperand ; sh:hasValue odrl:count ] ]
        [ sh:path odrl:rightOperand ; sh:datatype xsd:integer ]
    ) ;
    sh:message "The rightOperand of odrl:count should be an xsd:integer." .


# R52: the rightOperand of odrl:dateTime must be an xsd:date or xsd:dateTime

:DateTimeRightOperandShape a sh:NodeShape ;
    sh:targetClass odrl:Constraint ;
    sh:targetSubjectsOf odrl:leftOperand ; 
    sh:severity sh:Violation ;
    sh:or (
        [ sh:not [ sh:path odrl:leftOperand ; sh:hasValue odrl:dateTime ] ]
        [ sh:path odrl:rightOperand ; sh:or ( [ sh:datatype xsd:date ] [ sh:datatype xsd:dateTime ] ) ]
    ) ;
    sh:message "The rightOperand of odrl:dateTime must be an xsd:date or xsd:dateTime." .


# R54: the rightOperand of odrl:delayPeriod must be an xsd:duration

:DelayPeriodRightOperandShape a sh:NodeShape ;
    sh:targetClass odrl:Constraint ;
    sh:targetSubjectsOf odrl:leftOperand ; 
    sh:severity sh:Violation ;
    sh:or (
        [ sh:not [ sh:path odrl:leftOperand ; sh:hasValue odrl:delayPeriod ] ]
        [ sh:path odrl:rightOperand ; sh:datatype xsd:duration ]
    ) ;
    sh:message "The rightOperand of odrl:delayPeriod must be an xsd:duration." .


# R56: the rightOperand of odrl:deliveryChannel must be an IRI, a string, or a list of these

:DeliveryChannelRightOperandShape a sh:NodeShape ;
    sh:targetClass odrl:Constraint ;
    sh:targetSubjectsOf odrl:leftOperand ;
    sh:severity sh:Warning ;
    sh:or (
        [ sh:not [ sh:path odrl:leftOperand ; sh:hasValue odrl:deliveryChannel ] ]
        [ sh:path odrl:rightOperand ; sh:or ( [ sh:nodeKind sh:IRI ] [ sh:datatype xsd:string ] [ sh:node :IriOrStringListShape ] ) ]
    ) ;
    sh:message "The rightOperand of odrl:deliveryChannel should be an IRI, a string, or a list of these." .


# R58: the rightOperand of odrl:elapsedTime must be an xsd:duration

:ElapsedTimeRightOperandShape a sh:NodeShape ;
    sh:targetClass odrl:Constraint ;
    sh:targetSubjectsOf odrl:leftOperand ;
    sh:severity sh:Violation ;
    sh:or (
        [ sh:not [ sh:path odrl:leftOperand ; sh:hasValue odrl:elapsedTime ] ]
        [ sh:path odrl:rightOperand ; sh:datatype xsd:duration ]
    ) ;
    sh:message "The rightOperand of odrl:elapsedTime must be an xsd:duration." .


# R60: the rightOperand of odrl:event must be an IRI or a string

:EventRightOperandShape a sh:NodeShape ;
    sh:targetClass odrl:Constraint ;
    sh:targetSubjectsOf odrl:leftOperand ;
    sh:severity sh:Warning ;
    sh:or (
        [ sh:not [ sh:path odrl:leftOperand ; sh:hasValue odrl:event ] ]
        [ sh:path odrl:rightOperand ; sh:or ( [ sh:nodeKind sh:IRI ] [ sh:datatype xsd:string ] ) ]
    ) ;
    sh:message "The rightOperand of odrl:event should be an IRI or a string." .


