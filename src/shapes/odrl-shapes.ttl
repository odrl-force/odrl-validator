:IndustryRightOperandShape a sh:NodeShape ;
    sh:targetClass odrl:Constraint ;
    sh:targetSubjectsOf odrl:leftOperand ;
    sh:severity sh:Warning ;
    sh:or (
        [ sh:not [ sh:path odrl:leftOperand ; sh:hasValue odrl:industry ] ]
