#################################################
# Shape for Party
#################################################

:PartyShape a sh:NodeShape ;
    sh:targetClass odrl:Party ;

    sh:property [
        sh:path odrl:uid ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "A Party may have one uid, and it must be an IRI." ;
    ] ;

    sh:property [
        sh:path odrl:partOf ;
        sh:node :PartyCollectionShape ;
        sh:message "partOf should point to an PartyCollection." ;
    ] ;
    # The collection may have no type, but it must not be an Asset.
    sh:property [
        sh:path odrl:partOf ;
        sh:not [ sh:or ( [ sh:class odrl:Asset ] [ sh:class odrl:AssetCollection ] ) ] ;
        sh:message "A Party must be partOf a PartyCollection, not an Asset or AssetCollection." ;
    ] .


:PartyCollectionShape a sh:NodeShape ;

    sh:property [
        sh:path odrl:source ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "A PartyCollection may have one source, and it must be an IRI." ;
    ] ;
    
    sh:property [
        sh:path odrl:refinement ;
        sh:or (
            [ sh:node :ConstraintShape ]
            [ sh:node :LogicalConstraintShape ]
        ) ;
        sh:message "Each PartyCollection refinement must be a Constraint or LogicalConstraint." ;
    ] .
    