#################################################
# Shape for Policy
#################################################

:PolicyShape a sh:NodeShape ;
    sh:targetClass odrl:Policy ;
    # Only policies have rules: this also finds policies whose class is unknown (e.g. from a profile that is not loaded).
    sh:targetSubjectsOf odrl:permission, odrl:prohibition, odrl:obligation ;
    sh:nodeKind sh:IRI ;
    sh:message "Policies must be identified by an IRI." ;

    sh:property [
        sh:path rdf:type ;
        sh:qualifiedValueShape [
            sh:in ( odrl:Policy odrl:Agreement odrl:Assertion odrl:Offer odrl:Privacy odrl:Request odrl:Set odrl:Ticket ) ;
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "The policy type must be an ODRL policy class, or a subclass of odrl:Policy defined in a loaded profile." ;
    ] ;

    sh:property [
        sh:path odrl:uid ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "A Policy may have one uid, and it must be an IRI." ;
    ] ;

    sh:property [
        sh:path [ sh:alternativePath ( odrl:permission odrl:prohibition odrl:obligation ) ] ;
        sh:minCount 1 ;
        sh:message "Policies must have at least one permission, obligation or prohibition." ;
    ] ;

    # A rule may have no type (it follows from the property), but it must not have the type of another rule.

    sh:property [
        sh:path odrl:permission ;
        sh:node :PermissionShape ;
    ] ;
    sh:property [
        sh:path odrl:permission ;
        sh:not [ sh:or ( [ sh:class odrl:Prohibition ] [ sh:class odrl:Duty ] ) ] ;
        sh:message "A permission must be an odrl:Permission, not a Prohibition or Duty." ;
    ] ;

    sh:property [
        sh:path odrl:obligation ;
        sh:node :DutyShape ;
    ] ;
    sh:property [
        sh:path odrl:obligation ;
        sh:not [ sh:or ( [ sh:class odrl:Permission ] [ sh:class odrl:Prohibition ] ) ] ;
        sh:message "An obligation must be an odrl:Duty, not a Permission or Prohibition." ;
    ] ;

    sh:property [
        sh:path odrl:prohibition ;
        sh:node :ProhibitionShape ;
    ] ;
    sh:property [
        sh:path odrl:prohibition ;
        sh:not [ sh:or ( [ sh:class odrl:Permission ] [ sh:class odrl:Duty ] ) ] ;
        sh:message "A prohibition must be an odrl:Prohibition, not a Permission or Duty." ;
    ] ;

    sh:property [
        sh:path odrl:profile ;
        sh:nodeKind sh:IRI ;
        sh:message "Profile must be an IRI." ;
    ] ;

    sh:property [
        sh:path odrl:inheritFrom ;
        sh:nodeKind sh:IRI ;
        sh:class odrl:Policy ;
        sh:message "inheritFrom must reference an existing odrl:Policy." ;
    ] ;

    sh:property [
        sh:path odrl:conflict ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
        sh:message "Conflict strategy must appear at most once and be a ConflictTerm: odrl:perm, odrl:prohibit, or odrl:invalid." ;
    ] .

:ConflictStrategyShape a sh:NodeShape ;
    sh:targetClass odrl:Policy, odrl:Set, odrl:Offer, odrl:Agreement ;
    sh:property [
        sh:severity sh:Violation ;
        sh:path odrl:conflict ;
        sh:in ( odrl:perm odrl:prohibit odrl:invalid ) ;
        sh:message "The conflict strategy must be odrl:perm, odrl:prohibit or odrl:invalid, or a conflict term defined in a loaded profile." ;
    ] .

# Set = Policy

:SetPolicyShape a sh:NodeShape ;
    sh:targetClass odrl:Set ;
    sh:node :PolicyShape .


# Offer = Rules must have one assigner

:OfferPolicyShape a sh:NodeShape ;
    sh:targetClass odrl:Offer ;
    sh:node :PolicyShape ;

    sh:property [
        sh:path odrl:permission ;
        sh:node :OfferPermissionShape ;
    ] ;

    sh:property [
        sh:path odrl:prohibition ;
        sh:node :OfferProhibitionShape ;
    ] ;

    sh:property [
        sh:path odrl:obligation ;
        sh:node :OfferDutyShape ;
    ] .


# Agreement = Rules must have one assigner and one assignee

:AgreementPolicyShape a sh:NodeShape ;
    sh:targetClass odrl:Agreement ;
    sh:node :PolicyShape ;

    sh:property [
        sh:path odrl:permission ;
        sh:node :AgreementPermissionShape ;
    ] ;

    sh:property [
        sh:path odrl:prohibition ;
        sh:node :AgreementProhibitionShape ;
    ] ;

    sh:property [
        sh:path odrl:obligation ;
        sh:node :AgreementDutyShape ;
    ] .