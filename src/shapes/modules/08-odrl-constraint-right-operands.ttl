# R87: the rightOperand of odrl:spatial must be an IRI
# R90: the rightOperand of odrl:systemDevice must be an IRI or a string
# R92: the rightOperand of odrl:timeInterval must be an xsd:duration
# R94: the rightOperand of odrl:unitOfCount must be a string
# R96: the rightOperand of odrl:version must be a string
# R98: the rightOperand of odrl:virtualLocation must be a string




# An RDF list whose members are IRIs or strings
:IriOrStringListShape a sh:NodeShape ;
    sh:node :RdfListShape ;
    sh:property [
        sh:path ( [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:or ( [ sh:nodeKind sh:IRI ] [ sh:datatype xsd:string ] ) ;
    ] .

# An RDF list whose members are strings
:StringListShape a sh:NodeShape ;
    sh:node :RdfListShape ;
    sh:property [
        sh:path ( [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:datatype xsd:string ;
    ] .