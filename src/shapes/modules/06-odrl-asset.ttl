#################################################
# Shape for Asset
#################################################

:AssetShape a sh:NodeShape ;
    sh:targetClass odrl:Asset ;

    sh:property [
        sh:path odrl:uid ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "An Asset may have one uid, and it must be an IRI." ;
    ] ;

    sh:property [
        sh:path odrl:partOf ;
        sh:node :AssetCollectionShape ;
        sh:message "partOf should point to an AssetCollection." ;
    ] ;
    # The collection may have no type, but it must not be a Party.
    sh:property [
        sh:path odrl:partOf ;
        sh:not [ sh:or ( [ sh:class odrl:Party ] [ sh:class odrl:PartyCollection ] ) ] ;
        sh:message "An Asset must be partOf an AssetCollection, not a Party or PartyCollection." ;
    ] ;

    sh:property [
        sh:path odrl:hasPolicy ;
        sh:nodeKind sh:IRI ;
        sh:message "hasPolicy must point to a Policy IRI." ;
    ] .

:AssetCollectionShape a sh:NodeShape ;
    
    sh:property [
        sh:path odrl:source ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "An AssetCollection may have one source, and it must be an IRI." ;
    ] ;
    
    sh:property [
        sh:path odrl:refinement ;
        sh:or (
            [ sh:node :ConstraintShape ]
            [ sh:node :LogicalConstraintShape ]
        ) ;
        sh:message "Each AssetCollection refinement must be a Constraint or LogicalConstraint." ;
    ] .
    